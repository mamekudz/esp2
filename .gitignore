.pio
.cache
compile_commands.json

# Node / µGulp
node_modules/
.microgulp/
npm-debug.log*
package-lock.json.bak

# Local NAS targets (never commit real paths)
config/nas.targets.local
.env
.env.*
!.env.example
!.env.*.example

# Secrets / credentials / private keys
*.pem
*.key
*.p12
*.pfx
*credentials*
*secrets*
.settings_private*
settings_private.*

# IDE caches
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.vscode/*.log
.idea/
*.swp
*~

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Local refs / vendor dumps (not project source)
*_refs
_refs/

# Transient logs from bring-up sessions
*_log.txt
build_log.txt
upload_log.txt
monitor_log.txt
pkg_install_log.txt

# Python
*.pyc
__pycache__/

# Disk images / ROMs (users provide their own; never ship copyrighted media)
*.dsk
*.po
*.nib
*.woz
*.rom
*.ROM
# Allow only synthetic / redistributable project fixtures (never commercial media)
!fixtures/synthetic/**
!fixtures/redistributable/**

# User-supplied motherboard / slot ROMs (local only)
local/roms/**
!local/roms/README.md

# Local ROM path config (personal)
config/roms.local.json

# Local full machine config (personal paths)
config/apple2.local.json


# User-imported library media (local only)
library/user/

# apple2js local caches (also covered by .cache/)
.cache/apple2js/
.cache/apple2js-meta/

# Host test output
host/.out/
host/coverage/
*.ppm
*.pgm

# Portable host C++ toolchain (LLVM-MinGW) — do not commit
tools/host-toolchain/

# Unfinished / superseded local vendor dumps
vendor/

# Local host C++ toolchain (do not commit)
tools/host-toolchain/

# clangd / coverity
.cache/
compile_commands.json
