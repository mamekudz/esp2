{
  "name": "esp2",
  "version": "0.1.0",
  "private": true,
  "description": "ESP][ — µGulp / Gulp task runner (Apple II emulator bring-up)",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "gulp build",
    "flash": "gulp flash",
    "upload": "gulp upload",
    "monitor": "gulp monitor",
    "clean": "gulp clean",
    "rebuild": "gulp rebuild",
    "devices": "gulp devices",
    "size": "gulp size",
    "docs": "gulp docs",
    "backup": "gulp backup",
    "backup:git": "gulp backup:git",
    "backup:nas": "gulp backup",
    "backup:all": "gulp backup:all",
    "test:infra": "node --test dev/tools/infra.test.mjs",
    "test:mugulp-catalog": "node --test dev/tools/mugulp-task-catalog.test.mjs",
    "test:mugulp-smoke": "node --test dev/tools/mugulp-catalog-smoke.test.mjs",
    "test:apple2-local": "node --test dev/tools/apple2-local/apple2-local.test.mjs",
    "i18x:gulp": "node dev/tools/build-i18x-gulp.mjs",
    "git:status": "gulp git:status",
    "git:commit": "gulp git:commit",
    "git:push": "gulp git:push",
    "backup:list": "gulp backup:list",
    "backup:verify": "gulp backup:verify",
    "firmware:env": "gulp firmware:env",
    "format:check": "gulp format:check",
    "test:host": "node host/test/run.mjs",
    "fixture:dsk": "node host/tools/gen_blank_dsk.mjs",
    "apple2js:sync": "gulp apple2js:sync",
    "apple2js:catalog": "gulp apple2js:catalog",
    "apple2js:audit": "gulp apple2js:audit",
    "fixture:test-disks": "node host/tools/gen_test_disks.mjs",
    "test:apple2": "node host/tools/build_and_test_apple2.mjs",
    "apple2:rom-test": "node host/tools/rom_test.mjs",
    "apple2:rom-identify": "node host/tools/rom_test.mjs --identify-only",
    "gulp:tasks": "gulp --tasks",
    "device:upload": "gulp device:upload",
    "device:usb-storage": "gulp device:usb-storage",
    "test:upload": "node --test dev/tools/esp2-upload.test.mjs"
  },
  "microgulp": {
    "ready": true
  },
  "devDependencies": {
    "gulp": "^5.0.0",
    "gulp-mu-gulp-api": "^0.5.0",
    "serialport": "^13.0.0"
  }
}
