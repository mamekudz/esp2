# EditorConfig for ESP][

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cpp,h,hpp,cc,hh}]
indent_style = space
indent_size = 4

[*.{js,mjs,cjs,json,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
